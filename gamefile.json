{
   "name": "TCGRPG",
   "deckBuilding": {
      "mainFilters": ["type", "cost", "color"],
      "costCurveIgnoredTypes": ["Leader"],
      "formats": [
         {
            "title": "Standard",
            "gameplay": "Classic",
            "legalityCode": "STD",
            "deckRuleset": "Classic"
         }
      ],
      "deckRulesets": {
         "Classic": {
            "checkCardLegality": true,
            "general": {
               "min": 41,
               "max": 51,
               "maxPerCard": 3
            },
            "categories": [
               {
                  "category": "Leader",
                  "min": 1,
                  "max": 1
               },
               {
                  "category": "Sideboard",
                  "maxPerCard": 3
               }
            ]
         }
      }
   },
   "gameplay": {
      "Classic": {
         "beforeGameStart": {
            "chooseAnotherStartingPlayer": true
         },
         "mulligan": {
            "startingHandSize": 5,
            "mulliganCount": { "max": 1 }
         },
         "newTurn": {
            "drawOnStart": false,
            "drawPerTurn": 1
         },
         "defaultNotes": "Counter 1: Punti vita (inizio 20)\nCounter 2: Mana (inizio 0; aggiungi 1 manualmente a ogni turno)",
         "countersStartingValues": [20, 0],
         "sections": {
            "customSections": ["Campo", "Leader", "Others"],
            "layout": {
               "direction": "column",
               "content": [
                  {
                     "direction": "row",
                     "content": [
                        { "section": "Campo" },
                        { "section": "Leader", "style": { "width": "15vh" } }
                     ]
                  },
                  {
                     "direction": "row",
                     "content": [ { "section": "Mana" }, { "section": "Others" } ]
                  }
               ],
               "isSymmetricalForOpponents": true
            },
            "categoriesAlreadyOnBoard": ["Leader"],
            "sectionsDict": {
               "Stack": {
                  "isDefaultSection": true,
                  "title": "Stack",
                  "isHidden": "no",
                  "height": "HUGE",
                  "alignment": "NONE",
                  "isHorizontalAllowed": false,
                  "isGroupForbidden": true,
                  "displayedTitle": "Pile"
               },
               "Campo": {
                  "title": "Campo",
                  "isHidden": "no",
                  "height": "MEDIUM",
                  "alignment": "CENTER",
                  "isHorizontalAllowed": true,
                  "enterTapped": true,
                  "displayedTitle": "Campo"
               },
               "Leader": {
                  "title": "Leader",
                  "isHidden": "no",
                  "height": "DEFAULT",
                  "alignment": "CENTER",
                  "isHorizontalAllowed": true,
                  "noQuickActions": true
               },
               "Mana": {
                  "title": "Mana",
                  "isHidden": "no",
                  "height": "DEFAULT",
                  "alignment": "START",
                  "displayedTitle": "Mana",
                  "noQuickActions": true
               },
               "Others": {
                  "title": "Others",
                  "isHidden": "no",
                  "height": "DEFAULT",
                  "alignment": "START",
                  "displayedTitle": "Others",
                  "noQuickActions": true
               },
               "autoPlayFromHand": {
                  "Creatura": "Campo",
                  "Magia": "Stack"
               },
               "autoPlayFromStack": {
                  "Creatura": "Campo",
                  "Magia": "Discard"
               }
            }
         }
      }
   },
   "cards": {
      "dataUrl": "https://michele-brignola.github.io/TCGRPG/cards.json",
      "cardBack": "https://michele-brignola.github.io/TCGRPG/img/mtg_cardback.webp"
   }
}
