{
  "name": "TCGRPG",
  "deckBuilding": {
    "mainFilters": ["tipo", "costo", "colore"],
    "costCurveIgnoredTypes": ["Leader"],
    "formats": [
      {
        "title": "Standard",
        "gameplay": "Standard",
        "deckRuleset": "Standard",
        "legalityCode": "STD"
      }
    ],
    "deckRulesets": {
      "Standard": {
        "general": { "min": 40, "max": 50, "maxPerCard": 3 },
        "categories": [{ "category": "Leader", "min": 1, "max": 1 }]
      }
    }
  },
  "gameplay": {
    "Standard": {
      "beforeGameStart": {
        "boardCategoriesInSideboard": ["Leader"],
        "boardCardSelection": [
          {
            "category": "LEADER",
            "min": 1,
            "max": 1,
            "unselectedDestination": "ExileHidden"
          }
        ],
        "chooseAnotherStartingPlayer": true
      },
      "mulligan": { "startingHandSize": 5 },
      "newTurn": { "drawOnStart": true, "drawPerTurn": 1 },
      "defaultNotes": "P1 life: 20\nP2 life: 20",
      "countersStartingValues": [20],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            { "section": "Board" },
            {
              "direction": "row",
              "content": [{ "section": "Mana" }, { "section": "Items" }]
            }
          ]
        },
        "sectionsDict": {
          "Board": {
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER"
          }
        }
      },
      "autoPlayFromHand": {
        "Creature": "Board",
        "Resource": "Mana",
        "Spell": "Stack"
      },
      "autoPlayFromStack": {
        "Spell": "Discard"
      }
    }
  },
  "cards": {
    "dataUrl": "https://example.com/cards.json",
    "cardBack": "https://example.com/card-back.jpg"
  }
}
